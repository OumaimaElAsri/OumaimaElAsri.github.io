---
// Layout principal
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Oumaima El Asri — Data Engineer · IA · Full Stack",
  description = "Portfolio de Oumaima El Asri, Data Engineer spécialisée en pipelines Big Data, ML et développement Full Stack."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
</head>
<body>
  <slot/>
  <div id="cursor-glow"></div>
  <footer>
    <span class="fc">© 2026 Oumaima El Asri — Nantes, France</span>
    <div class="fl">
      <a href="https://www.linkedin.com/in/oumaimaelasri" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://github.com/OumaimaElAsri" target="_blank" rel="noopener">GitHub</a>
      <a href="mailto:elasriioumaima@gmail.com">Email</a>
    </div>
  </footer>

  <script>
    // ── BG PARTICLES ──
    (function(){
      const c = document.getElementById('bg-canvas') as HTMLCanvasElement;
      if (!c) return;
      const x = c.getContext('2d')!;
      function sz(){ c.width = innerWidth; c.height = innerHeight; }
      sz(); window.addEventListener('resize', sz);
      const D = Array.from({length:50}, () => ({
        px: Math.random()*innerWidth, py: Math.random()*innerHeight,
        r: 1.5+Math.random()*3, vx: (Math.random()-.5)*.28, vy: (Math.random()-.5)*.28,
        sq: Math.random()>.65, sz: 3+Math.random()*6,
        a: .08+Math.random()*.38, ph: Math.random()*Math.PI*2,
        pu: Math.random()>.42
      }));
      function loop(){
        x.clearRect(0,0,c.width,c.height);
        for(const d of D){
          d.ph+=.007; d.px+=d.vx; d.py+=d.vy;
          if(d.px<0||d.px>c.width) d.vx*=-1;
          if(d.py<0||d.py>c.height) d.vy*=-1;
          const a = Math.max(0, d.a+Math.sin(d.ph)*.06);
          x.globalAlpha = a;
          const col = d.pu ? '167,139,250' : '220,220,220';
          if(d.sq){ x.fillStyle=`rgb(${col})`; x.fillRect(d.px,d.py,d.sz,d.sz); }
          else{ x.beginPath(); x.arc(d.px,d.py,d.r,0,Math.PI*2); x.fillStyle=`rgb(${col})`; x.fill(); }
        }
        x.globalAlpha = 1;
        requestAnimationFrame(loop);
      }
      loop();
    })();

    // ── REVEAL ──
    const ro = new IntersectionObserver(
      es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }),
      { threshold: .08 }
    );
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

    // ── SMOOTH SCROLL ──
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const href = (a as HTMLAnchorElement).getAttribute('href')!;
        const t = document.querySelector(href);
        if(t){ e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
      });
    });

    // ── MOBILE MENU ──
    (window as any).toggleMenu = function(){ document.getElementById('mob-menu')!.classList.toggle('open'); };
    (window as any).closeMenu  = function(){ document.getElementById('mob-menu')!.classList.remove('open'); };

    // ── CURSOR GLOW ──
    const glow = document.getElementById('cursor-glow');
    if (glow && window.innerWidth > 900) {
      document.addEventListener('mousemove', e => {
        if(!glow.classList.contains('active')) glow.classList.add('active');
        glow.style.transform = `translate(${e.clientX - 200}px, ${e.clientY - 200}px)`;
      });
    }

    // ── 3D TILT EFFECT ──
    if (window.innerWidth > 900) {
      const tiltElements = document.querySelectorAll('.bc, .story-stats, .skill-block, .val-card, .traj-card, .pcard');
      tiltElements.forEach(el => {
        const he = el as HTMLElement;
        he.addEventListener('mousemove', e => {
          const rect = he.getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = ((y - centerY) / centerY) * -3; 
          const rotateY = ((x - centerX) / centerX) * 3;
          he.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
          he.style.transition = 'transform 0.1s ease';
          he.style.zIndex = '20';
        });
        he.addEventListener('mouseleave', () => {
          he.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
          he.style.transition = 'transform 0.5s ease';
          he.style.zIndex = '1';
        });
      });
    }

    // ── NUMBERS ANIMATION ──
    const numObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.getAttribute('data-val') || '0');
          const prefix = el.getAttribute('data-prefix') || '';
          const suffix = el.getAttribute('data-suffix') || '';
          const isReverse = el.getAttribute('data-reverse') === 'true';
          const start = parseInt(el.getAttribute('data-start') || '0');
          
          let current = start;
          const duration = 2000;
          const steps = 60;
          const stepTime = Math.abs(Math.floor(duration / steps));
          const totalDiff = isReverse ? start - target : target - start;
          const increment = totalDiff / steps;

          const timer = setInterval(() => {
            if (isReverse) {
              current -= increment;
              if (current <= target) { current = target; clearInterval(timer); }
            } else {
              current += increment;
              if (current >= target) { current = target; clearInterval(timer); }
            }
            el.innerHTML = prefix + Math.floor(current) + suffix;
          }, stepTime);
          
          obs.unobserve(el);
        }
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('.num-anim').forEach(el => numObserver.observe(el));
  </script>

  <script>
    // ── TRAJECTORY ──
    const STEPS = [
      { 
        num:1, name:{ fr:'Université Sultan Moulay Slimane', en:'Sultan Moulay Slimane University' }, date:{ fr:'2019 – 2023 · Beni Mellal, Maroc', en:'2019 – 2023 · Beni Mellal, Morocco' }, 
        role: { fr: 'Licence Mathématiques & Informatique', en: 'Bachelor in Mathematics & Computer Science' },
        bullets: [
          { fr:'Python, POO avancée (Java/C++), algorithmique, SQL, réseaux, systèmes Linux', en:'Python, advanced OOP (Java/C++), algorithms, SQL, networks, Linux systems' }
        ],
        chips:['Python','POO Java/C++','SQL','Algorithmique','Linux','Réseaux'], col:[100,180,255] 
      },
      { 
        num:2, name:{ fr:'Daher', en:'Daher' }, date:{ fr:'Jan. – Juin 2024 · Casablanca', en:'Jan. – Jun. 2024 · Casablanca' },
        role: { fr:'Développeuse Data & ML (Stage)', en:'Data & ML Developer (Internship)' },
        bullets: [
          { fr:'Modèle de prédiction des stocks à J+7 (Random Forest) intégré au SI logistique', en:'J+7 stock prediction model (Random Forest) integrated into the logistics IS' },
          { fr:'Nettoyage et restructuration MySQL ; réécriture SQL pour meilleures performances', en:'MySQL cleaning and restructuring; SQL rewriting for better performance' },
          { fr:'Restitution des résultats en tableaux de bord pour les responsables achats', en:'Dashboard results presented to purchasing managers' }
        ],
        chips:['Scikit-learn','Pandas','MySQL','Random Forest','Data Viz','SQL'], col:[167,139,250] 
      },
      { 
        num:3, name:{ fr:'Marsa Maroc', en:'Marsa Maroc' }, date:{ fr:'Oct. 2024 – Mars 2025 · Casablanca', en:'Oct. 2024 – Mar. 2025 · Casablanca' }, 
        role: { fr:'Administratrice Systèmes & Data Analyst (Stage)', en:'Systems Admin & Data Analyst (Internship)' },
        bullets: [
          { fr:'Suivi des systèmes de traitement des données portuaires', en:'Monitoring of port data processing systems' },
          { fr:"Taux d'erreur ramené de 15% à moins de 1% via scripts Python", en:'Error rate reduced from 15% to under 1% via Python scripts' },
          { fr:'Tableaux de bord Power BI utilisés chaque semaine par les équipes opérationnelles', en:'Power BI dashboards used weekly by operational teams' }
        ],
        chips:['Power BI','Python','SQL','ETL','Excel avancé'], col:[80,210,160] 
      },
      { 
        num:4, name:{ fr:'EPSI Nantes — Formation', en:'EPSI Nantes — Education' }, date:{ fr:'Oct. 2025 – Présent · Nantes', en:'Oct. 2025 – Present · Nantes' },
        role: { fr: 'M1 Expert Informatique & Systèmes d\'Information', en: 'M1 IT & Information Systems Expert' },
        bullets: [
          { fr: 'Big Data (Apache Spark), AWS Cloud, ETL (Airflow), Python/R, Power BI, ML, IA, RGPD', en: 'Big Data (Apache Spark), AWS Cloud, ETL (Airflow), Python/R, Power BI, ML, AI, GDPR' },
          { fr: 'Alternance : 2 semaines entreprise / 1 semaine école', en: 'Work-study: 2 weeks company / 1 week school' }
        ],
        chips:['Apache Spark','Airflow','AWS','Power BI','ML','IA','RGPD'], col:[255,175,75] 
      },
      { 
        num:5, name:{ fr:'UGSEL', en:'UGSEL' }, date:{ fr:'Mars – Juil. 2026 · Nantes', en:'Mar. – Jul. 2026 · Nantes' }, 
        role: { fr:'Développeuse Full Stack Data (Stage)', en:'Data Full Stack Developer (Internship)' },
        bullets: [
          { fr:'Conception et déploiement de TournoUGSEL — outil pour 25 établissements, ~500 participants/an', en:'Design and deployment of TournoUGSEL — tool for 25 schools, ~500 participants/year' },
          { fr:'Scripts de nettoyage et validation de fichiers XLS/XLSX hétérogènes', en:'Cleaning and validation scripts for heterogeneous XLS/XLSX files' },
          { fr:'Algorithme de constitution automatique des poules par niveau et zone géographique', en:'Automatic pool creation algorithm by level and geographic zone' },
          { fr:'Dictionnaire de données pour aligner les équipes métier et technique', en:'Data dictionary to align business and technical teams' }
        ],
        chips:['React','Python','SQLite','TypeScript','SheetJS','RGPD'], col:[255,110,140] 
      },
      { 
        num:6, name:{ fr:'Exploration IA & Agents LLM', en:'AI Agents & LLM Pipeline Exploration' }, date:{ fr:'2025 – Présent', en:'2025 – Present' },
        role: { fr: 'Développement Personnel & R&D', en: 'Personal Development & R&D' },
        bullets: [
          { fr: 'Construction de pipelines LLM et systèmes d\'automatisation data intelligents.', en: 'Building LLM pipelines and intelligent data automation systems.' },
          { fr: 'Exploration des workflows IA agentiques et architectures RAG.', en: 'Exploring agentic AI workflows and RAG architectures.' }
        ],
        chips:['LLMs','RAG','MLOps','Agents IA','Python'], col:[140,240,110] 
      },
    ];

    const tc = document.getElementById('traj-canvas') as HTMLCanvasElement;
    const tx = tc.getContext('2d')!;
    let TW=0, TH=0, tIdx=0, tAngle=0, tTarget=0, tParts: any[]=[];

    function szTraj(){
      TW=tc.offsetWidth; TH=tc.offsetHeight;
      const dpr=Math.min(devicePixelRatio,2);
      tc.width=TW*dpr; tc.height=TH*dpr;
      tx.scale(dpr,dpr);
    }
    szTraj();
    window.addEventListener('resize',()=>{ szTraj(); });

    function mkParts(col: number[]){
      return Array.from({length:55},()=>({
        px:Math.random()*TW, py:Math.random()*TH,
        vx:(Math.random()-.5)*.4, vy:(Math.random()-.5)*.4,
        r:1.2+Math.random()*3.2, sq:Math.random()>.62, sz:3+Math.random()*7,
        a:.07+Math.random()*.38, ph:Math.random()*Math.PI*2, col
      }));
    }
    tParts = mkParts(STEPS[0].col);

    function p3(x:number,y:number,z:number,cx:number,cy:number,sc:number,ang:number, py:number, pz:number){
      const cos=Math.cos(ang), sin=Math.sin(ang);
      return{ px:cx+(x*cos-z*sin)*sc, py:cy+y*sc*py+(x*sin+z*cos)*sc*pz };
    }

    function drawIsland(cx:number,cy:number,sc:number,ang:number,col:number[], time:number, stepIdx:number, py:number, pz:number){
      const P=(x:number,y:number,z:number)=>p3(x,y,z,cx,cy,sc,ang, py, pz);
      const [r,g,b]=col;
      const C=(a:number)=>`rgba(${r},${g},${b},${a})`;
      
      tx.globalCompositeOperation = 'screen';

      // Outer Orbital Rings
      tx.lineWidth = 1;
      for (let cr=1.8; cr<=4.2; cr+=0.6) {
        tx.beginPath();
        for(let i=0; i<=40; i++) {
          const a = (i/40)*Math.PI*2;
          const w = P(Math.cos(a)*cr, 0, Math.sin(a)*cr);
          if (i===0) tx.moveTo(w.px, w.py); else tx.lineTo(w.px, w.py);
        }
        tx.strokeStyle = C(0.1 + (cr<=2.4?0.15:0));
        tx.stroke();
      }

      tx.globalCompositeOperation = 'source-over';

      // Base solid hexagon
      const H = Array.from({length:6}, (_,i)=>{
        const a = (i/6)*Math.PI*2 + Math.PI/6;
        return [Math.cos(a)*1.6, 0, Math.sin(a)*1.6];
      });
      const tp = H.map(([x,,z])=>P(x!,0,z!));
      const bt = H.map(([x,,z])=>P(x!,0.4,z!));
      for(let i=0; i<6; i++){
        const ni = (i+1)%6;
        tx.beginPath();
        tx.moveTo(tp[i].px, tp[i].py); tx.lineTo(tp[ni].px, tp[ni].py);
        tx.lineTo(bt[ni].px, bt[ni].py); tx.lineTo(bt[i].px, bt[i].py);
        tx.fillStyle = C(.04+.02*(i%2)); tx.strokeStyle = C(.2); tx.lineWidth=0.8; tx.fill(); tx.stroke();
      }
      
      // Top face Grid
      tx.beginPath(); tp.forEach((p,i)=>i?tx.lineTo(p.px,p.py):tx.moveTo(p.px,p.py));
      tx.fillStyle = C(.08); tx.fill(); tx.strokeStyle = C(0.4); tx.stroke();
      for(let i=-1.2; i<=1.2; i+=0.3) {
         tx.beginPath(); tx.moveTo(P(i, 0, -1.2).px, P(i, 0, -1.2).py); tx.lineTo(P(i, 0, 1.2).px, P(i, 0, 1.2).py);
         tx.strokeStyle=C(0.15); tx.lineWidth=1; tx.stroke();
         tx.beginPath(); tx.moveTo(P(-1.2, 0, i).px, P(-1.2, 0, i).py); tx.lineTo(P(1.2, 0, i).px, P(1.2, 0, i).py);
         tx.strokeStyle=C(0.15); tx.stroke();
      }

      // Circuit lines on floor
      for(let i=0; i<6; i++){
        const a = (i/6)*Math.PI*2 + Math.PI/6;
        const px = Math.cos(a)*1.4; const pz = Math.sin(a)*1.4;
        const pl_top = P(px, -0.2, pz);
        const pl_bot = P(px, 0, pz);
        tx.beginPath(); tx.moveTo(pl_top.px, pl_top.py); tx.lineTo(pl_bot.px, pl_bot.py);
        tx.strokeStyle=C(0.8); tx.lineWidth=1.5; tx.stroke();
        tx.beginPath(); tx.arc(pl_top.px, pl_top.py, 1.5, 0, Math.PI*2);
        tx.fillStyle=C(1); tx.fill();
        // line to center
        tx.beginPath(); tx.moveTo(pl_bot.px, pl_bot.py); tx.lineTo(P(0,0,0).px, P(0,0,0).py);
        tx.strokeStyle=C(0.4); tx.lineWidth=1; tx.stroke();
      }

      // Central Databanks (Stacked cubes)
      const layers = 5;
      for(let l=0; l<layers; l++) {
          const yh = -0.15 - l*0.35 + Math.sin(time*3 + l)*0.06; 
          const bw = 0.45 - l*0.03; const lh = 0.18;
          const B = [
             P(-bw, yh, bw), P(bw, yh, bw), P(bw, yh, -bw), P(-bw, yh, -bw),
             P(-bw, yh-lh, bw), P(bw, yh-lh, bw), P(bw, yh-lh, -bw), P(-bw, yh-lh, -bw)
          ];
          [[4,5,1,0],[5,6,2,1],[4,5,6,7]].forEach((f,fi)=>{
             tx.beginPath(); f.forEach((i,j)=>j?tx.lineTo(B[i].px,B[i].py):tx.moveTo(B[i].px,B[i].py));
             tx.closePath(); 
             tx.fillStyle = C(.1 + (l*0.05) + fi*0.04); 
             tx.strokeStyle = C(.5 + l*0.1); 
             tx.lineWidth = 1; tx.fill(); tx.stroke();
             // Server blinkers
             if(fi < 2 && Math.random() > 0.4) {
                 const led = P(fi===0 ? -0.2 : 0.4, yh-0.08, fi===0 ? 0.45 : 0.2);
                 tx.beginPath(); tx.arc(led.px, led.py, 1.2, 0, Math.PI*2);
                 tx.fillStyle = Math.random()>0.2?C(1):'#fff'; tx.fill();
             }
          });
          // Core link
          tx.beginPath(); tx.moveTo(P(0,yh,0).px, P(0,yh,0).py); tx.lineTo(P(0,yh-lh,0).px, P(0,yh-lh,0).py);
          tx.strokeStyle=C(1); tx.lineWidth=2; tx.stroke();
      }

      tx.globalCompositeOperation = 'screen';

      // --- HOLOGRAPHIC 3D GIRL POSES (Changes per step) ---
      function drawHologramGirl(t, step) {
         const sz = 0.55;
         const genericDraw = (gcx, gcz, dirX, dirZ, rx, rz, animFn) => {
            const pt = (fwd, right, up) => P(gcx + dirX*fwd + rx*right, up*sz, gcz + dirZ*fwd + rz*right);
            tx.lineCap = 'round'; tx.lineJoin = 'round';
            animFn(pt);
         };

         // Base angle when she is standing/sitting still
         const baseAngle = -0.5; 
         const gcx = Math.cos(baseAngle) * 1.0;
         const gcz = Math.sin(baseAngle) * 1.0;
         const dirX = -Math.sin(baseAngle); const dirZ = Math.cos(baseAngle);
         const rx = Math.cos(baseAngle); const rz = Math.sin(baseAngle);

         const drawLimb = (pA, pB, col, lw) => {
             tx.beginPath(); tx.moveTo(pA.px, pA.py); tx.lineTo(pB.px, pB.py);
             tx.strokeStyle = C(col); tx.lineWidth = lw; tx.stroke();
         };
         
         const headGlow = (ptHead) => {
             tx.beginPath(); tx.arc(ptHead.px, ptHead.py, 3, 0, Math.PI*2); tx.fillStyle = '#fff'; tx.fill();
             tx.shadowColor = C(1); tx.shadowBlur = 12;
             tx.beginPath(); tx.arc(ptHead.px, ptHead.py, 3.5, 0, Math.PI*2); tx.fillStyle = C(1); tx.fill();
             tx.shadowBlur = 0;
         };
         
         if (step === 0) {
             // 0: ETUDIANTE (Sitting on the databank reading a book)
             genericDraw(0, 0.4, 1, 0, 0, 1, (pt) => { // sits on the edge
                 drawLimb(pt(0,-0.06,-0.6), pt(0.3,-0.06,-0.6), 0.5, 1.8); 
                 drawLimb(pt(0.3,-0.06,-0.6), pt(0.3,-0.06,0.0), 0.5, 1.8); 
                 drawLimb(pt(0,0.06,-0.6), pt(0.3,0.06,-0.6), 0.95, 2.2); 
                 drawLimb(pt(0.3,0.06,-0.6), pt(0.3,0.06,0.0), 0.95, 2.2); 
                 // Torso
                 tx.beginPath(); tx.moveTo(pt(0.05,0,-1.1).px, pt(0.05,0,-1.1).py);
                 tx.lineTo(pt(-0.1,0.1,-0.5).px, pt(-0.1,0.1,-0.5).py);
                 tx.lineTo(pt(0.1,-0.1,-0.5).px, pt(0.1,-0.1,-0.5).py); tx.closePath(); tx.fillStyle=C(0.7); tx.fill();
                 drawLimb(pt(0,0,-0.6), pt(0.05,0,-1.1), 0.9, 3.5); 
                 // Arms & Pad
                 drawLimb(pt(0.05,0,-1.1), pt(0.2,-0.15,-0.7), 0.5, 1.5);
                 drawLimb(pt(0.05,0,-1.1), pt(0.2,0.15,-0.7), 1, 1.8);
                 const pad = pt(0.25, 0, -0.6 + Math.sin(t*3)*0.03);
                 tx.beginPath(); tx.arc(pad.px, pad.py, 2.5, 0, Math.PI*2); tx.fillStyle=C(1); tx.fill();
                 headGlow(pt(0.08, 0, -1.35 + Math.sin(t*2)*0.02));
             });
         } else if (step === 1) {
             // 1: ANALYSTE ML (Standing, studying a floating data cube)
             genericDraw(gcx, gcz, dirX, dirZ, rx, rz, (pt) => {
                 drawLimb(pt(0,-0.06,-0.9), pt(0,-0.06,0), 0.5, 1.8);
                 drawLimb(pt(0,0.06,-0.9), pt(0,0.06,0), 0.95, 2.2);
                 drawLimb(pt(0,0,-0.9), pt(0.05,0,-1.5), 0.9, 3.5); 
                 drawLimb(pt(0.05,0,-1.5), pt(0.3,-0.15,-1.2), 0.5, 1.5);
                 drawLimb(pt(0.05,0,-1.5), pt(0.3,0.15,-1.2), 1, 1.8);
                 // Data Cube Analysis
                 const cp = pt(0.35, 0, -1.1 + Math.sin(t*4)*0.05);
                 tx.save(); tx.translate(cp.px, cp.py); tx.rotate(t*2);
                 tx.fillStyle=C(1); tx.fillRect(-3,-3,6,6); tx.restore();
                 headGlow(pt(0.05, 0, -1.7));
             });
         } else if (step === 2) {
             // 2: SYS ADMIN (Fast typing on holographic screens)
             genericDraw(gcx, gcz, dirX, dirZ, rx, rz, (pt) => {
                 drawLimb(pt(0,0,-0.8), pt(0.1,-0.15,0), 0.5, 1.8);
                 drawLimb(pt(0,0,-0.8), pt(-0.1,0.15,0), 0.95, 2.2);
                 drawLimb(pt(0,0,-0.8), pt(0.05,0,-1.4), 0.9, 3.5); 
                 const tl = Math.sin(t*25)*0.1; const tr = Math.cos(t*22)*0.1;
                 drawLimb(pt(0.05,0,-1.4), pt(0.2+tl,-0.15,-1.0), 0.5, 1.5);
                 drawLimb(pt(0.05,0,-1.4), pt(0.2+tr,0.15,-1.0), 1, 1.8);
                 const s1 = pt(0.3,-0.2,-0.9); const s2 = pt(0.3,0.2,-0.9);
                 drawLimb(pt(0.3,-0.3,-1.1), pt(0.3,0.3,-1.1), C(0.6), 2);
                 headGlow(pt(0.05, 0, -1.6));
             });
         } else if (step === 3) {
             // 3: EPSI M1 (Meditating, floating cross legged with data orbiting her)
             const fY = -0.5 + Math.sin(t*2)*0.2;
             genericDraw(gcx, gcz, dirX, dirZ, rx, rz, (pt) => {
                 drawLimb(pt(0,0,fY-0.2), pt(0.1,-0.1,fY), 0.5, 1.8);
                 drawLimb(pt(0.1,-0.1,fY), pt(-0.1,-0.1,fY), 0.5, 1.8);
                 drawLimb(pt(0,0,fY-0.2), pt(0.1,0.1,fY), 0.95, 2.2);
                 drawLimb(pt(0.1,0.1,fY), pt(-0.1,0.1,fY), 0.95, 2.2);
                 drawLimb(pt(0,0,fY-0.2), pt(0,0,fY-0.7), 0.9, 3.5); 
                 drawLimb(pt(0,0,fY-0.7), pt(0,-0.15,fY-0.2), 0.5, 1.5);
                 drawLimb(pt(0,0,fY-0.7), pt(0,0.15,fY-0.2), 1, 1.8);
                 for(let i=0;i<3;i++) {
                    const ob = pt(Math.cos(t*3+i*2)*0.3, Math.sin(t*3+i*2)*0.3, fY-0.4);
                    tx.beginPath(); tx.arc(ob.px, ob.py, 1.5, 0, Math.PI*2); tx.fillStyle=C(1); tx.fill();
                 }
                 headGlow(pt(0, 0, fY-0.9));
             });
         } else if (step === 5) {
             // 5: AGENTS IA / EXPLORATION (Levitating with energy wings / holding sphere)
             const fY = -0.8 + Math.sin(t*1.5)*0.3;
             genericDraw(gcx, gcz, dirX, dirZ, rx, rz, (pt) => {
                 drawLimb(pt(0,-0.06,fY-0.8), pt(-0.1,-0.06,fY), 0.5, 1.8);
                 drawLimb(pt(0,0.06,fY-0.8), pt(-0.1,0.06,fY), 0.95, 2.2);
                 drawLimb(pt(0,0,fY-0.8), pt(0.05,0,-1.5+fY), 0.9, 3.5); 
                 drawLimb(pt(0.05,0,-1.5+fY), pt(0.1,-0.2,-2.0+fY), 0.5, 1.5);
                 drawLimb(pt(0.05,0,-1.5+fY), pt(0.1,0.2,-2.0+fY), 1, 1.8);
                 const ball = pt(0.15, 0, -2.2+fY);
                 tx.beginPath(); tx.arc(ball.px, ball.py, 5 + Math.sin(t*10)*1.5, 0, Math.PI*2); tx.fillStyle=C(1); tx.fill();
                 headGlow(pt(0.05, 0, -1.8+fY));
                 // Energy wings
                 drawLimb(pt(0,0,-1.2+fY), pt(-0.3,-0.6,-1.5+fY), 0.6, 2);
                 drawLimb(pt(0,0,-1.2+fY), pt(-0.3,0.6,-1.5+fY), 0.6, 2);
             });
         } else {
             // 4: FULL STACK / DEFAULT (Walking forward with purpose)
             const oA = t * -0.5; 
             const lpt = (fwd, right, up) => P(Math.cos(oA) + -Math.sin(oA)*fwd + Math.cos(oA)*right, up*sz, Math.sin(oA) + Math.cos(oA)*fwd + Math.sin(oA)*right);
             const walk = t * 6;
             drawLimb(lpt(Math.sin(walk)*0.2,-0.06,-Math.max(0, -Math.cos(walk)*0.15)), lpt(0,-0.06,-0.9), 0.5, 1.8);
             drawLimb(lpt(0,0,-1.3), lpt(-Math.sin(walk)*0.18,-0.15,-0.7), 0.5, 1.5);
             tx.beginPath(); tx.moveTo(lpt(0.05,0,-1.35).px, lpt(0.05,0,-1.35).py); tx.lineTo(lpt(-0.1,0.1,-0.7).px, lpt(-0.1,0.1,-0.7).py); tx.lineTo(lpt(0.1,-0.1,-0.7).px, lpt(0.1,-0.1,-0.7).py); tx.closePath(); tx.fillStyle=C(0.7); tx.fill();
             drawLimb(lpt(0,0,-0.8), lpt(0.05,0,-1.35), 0.9, 3.5);
             drawLimb(lpt(Math.sin(walk+Math.PI)*0.2,0.06,-Math.max(0, -Math.cos(walk+Math.PI)*0.15)), lpt(0,0.06,-0.9), 0.95, 2.2);
             drawLimb(lpt(0,0,-1.3), lpt(-Math.sin(walk+Math.PI)*0.18,0.15,-0.75), 1, 1.8);
             headGlow(lpt(0.05, 0, -1.6));
         }
      }
      
      drawHologramGirl(time, stepIdx);

      // Floating data fragments
      for(let i=0; i<18; i++) {
          const a = ang*1.5 + time * (i%2===0?1.2:-0.8) + (i*Math.PI*2/18);
          const r0 = 1.8 + Math.sin(time*0.8 + i)*0.8;
          const y0 = -1.2 + Math.cos(time*1.2 + i)*1.5;
          const pP = P(Math.cos(a)*r0, y0, Math.sin(a)*r0);
          
          tx.beginPath(); tx.arc(pP.px, pP.py, Math.random()>0.8?2.5:1.2, 0, Math.PI*2);
          tx.fillStyle = C(Math.random()>0.5?1:0.6);
          tx.fill();
          
          if (Math.sin(time*4+i) > 0.85) {
             const cp = P(0, -0.6 - Math.random(), 0);
             tx.beginPath(); tx.moveTo(pP.px, pP.py); tx.lineTo(cp.px, cp.py);
             tx.strokeStyle = C(0.4); tx.lineWidth=0.5; tx.stroke();
          }
      }

      // Mega Core Beam
      const gp = P(0,-1.0,0);
      const topP = P(0, -9, 0);
      const grad = tx.createLinearGradient(gp.px, gp.py, topP.px, topP.py);
      grad.addColorStop(0, C(0.7 + Math.sin(time*10)*0.2));
      grad.addColorStop(1, C(0));
      
      tx.beginPath();
      tx.moveTo(P(-0.3,-1.0,0).px, P(-0.3,-1.0,0).py);
      tx.lineTo(P(0.3,-1.0,0).px, P(0.3,-1.0,0).py);
      tx.lineTo(P(0.05,-9,0).px, P(0.05,-9,0).py);
      tx.lineTo(P(-0.05,-9,0).px, P(-0.05,-9,0).py);
      tx.closePath();
      tx.fillStyle = grad;
      tx.fill();

      tx.globalCompositeOperation = 'source-over';
    }

    let _time = 0;
    
    // Variables pour l'animation de la caméra (Vue)
    let tSc = 1.1, tCy = 0.60, tPy = 0.42, tPz = 0.20;
    
    const camTarget = [
       {sc: 1.1, cy: 0.60, py: 0.42, pz: 0.20}, // 0: Normal
       {sc: 1.35, cy: 0.68, py: 0.30, pz: 0.12}, // 1: Zoom in, vue basse
       {sc: 1.0, cy: 0.58, py: 0.50, pz: 0.25}, // 2: Vue de dessus (Top-down)
       {sc: 1.3, cy: 0.65, py: 0.38, pz: 0.18}, // 3: Close up
       {sc: 1.1, cy: 0.60, py: 0.42, pz: 0.20}, // 4: Normal
       {sc: 0.85, cy: 0.45, py: 0.20, pz: 0.08}  // 5: Vue très large, presque horizon
    ];

    function trajLoop(){
      tx.clearRect(0,0,TW,TH);
      
      tAngle += (tTarget-tAngle)*.05; // ralenti légèrement la vitesse de rota
      tSc += (camTarget[tIdx].sc - tSc)*.05;
      tCy += (camTarget[tIdx].cy - tCy)*.05;
      tPy += (camTarget[tIdx].py - tPy)*.05;
      tPz += (camTarget[tIdx].pz - tPz)*.05;
      
      _time += 0.012;

      for(const d of tParts){
        d.ph+=.009; d.px+=d.vx; d.py+=d.vy;
        if(d.px<0||d.px>TW) d.vx*=-1;
        if(d.py<0||d.py>TH) d.vy*=-1;
        const a=Math.max(0,d.a+Math.sin(d.ph)*.06);
        const [r,g,b]=d.col;
        tx.globalAlpha=a;
        if(d.sq){ tx.fillStyle=`rgb(${r},${g},${b})`; tx.fillRect(d.px,d.py,d.sz,d.sz); }
        else{ tx.beginPath(); tx.arc(d.px,d.py,d.r,0,Math.PI*2); tx.fillStyle=`rgb(${r},${g},${b})`; tx.fill(); }
      }
      tx.globalAlpha=1;
      
      // Agrandissement global de 25% (Base * .20 au lieu de .16)
      const baseSc = Math.min(TW,TH)*.20; 
      drawIsland(TW/2, TH*tCy, baseSc * tSc, tAngle, STEPS[tIdx].col, _time, tIdx, tPy, tPz);
      requestAnimationFrame(trajLoop);
    }
    trajLoop();

    function renderPanel(){
      const s=STEPS[tIdx];
      const l=(window as any)._lang||'fr';
      document.getElementById('t-num')!.textContent=s.num.toString();
      document.getElementById('t-name')!.textContent=s.name[l as 'fr'|'en'];
      document.getElementById('t-badge')!.textContent=l==='fr'?'POINT DE TRAJECTOIRE':'TIMELINE POINT';
      document.getElementById('t-date')!.textContent=s.date[l as 'fr'|'en'];
      
      const roleEl = document.getElementById('t-role');
      if (roleEl) roleEl.textContent = s.role ? s.role[l as 'fr'|'en'] : '';

      const bulletsEl = document.getElementById('t-bullets');
      if (bulletsEl) {
        bulletsEl.innerHTML = s.bullets ? s.bullets.map(b => `<li>${b[l as 'fr'|'en']}</li>`).join('') : '';
      }

      document.getElementById('t-chips')!.innerHTML=s.chips.map((c:string)=>`<span class="chip">${c}</span>`).join('');
      (document.getElementById('t-prev') as HTMLButtonElement).style.opacity=tIdx===0?'0.25':'1';
      (document.getElementById('t-next') as HTMLButtonElement).style.opacity=tIdx===STEPS.length-1?'0.25':'1';
      (document.getElementById('t-prev') as HTMLButtonElement).disabled=tIdx===0;
      (document.getElementById('t-next') as HTMLButtonElement).disabled=tIdx===STEPS.length-1;
      document.getElementById('traj-dots')!.innerHTML=STEPS.map((_,i)=>`<span onclick="trajGo(${i})" style="width:${i===tIdx?22:7}px;height:7px;border-radius:4px;background:${i===tIdx?'#f5f5f5':'rgba(255,255,255,0.22)'};cursor:pointer;transition:all 0.3s;display:inline-block"></span>`).join('');
      tParts.forEach((d:any)=>{ d.col=s.col; });
    }

    (window as any).trajNav = function(dir: number){
      const n=tIdx+dir;
      if(n<0||n>=STEPS.length) return;
      tTarget+=dir*(Math.PI/3.2);
      tIdx=n;
      renderPanel();
    };
    (window as any).trajGo = function(idx: number){
      if(idx===tIdx) return;
      const dir=idx>tIdx?1:-1;
      tTarget+=dir*Math.abs(idx-tIdx)*(Math.PI/3.2);
      tIdx=idx;
      renderPanel();
    };
    renderPanel();

    document.addEventListener('keydown',e=>{
      if(['ArrowRight','ArrowLeft'].includes(e.key)){
        e.preventDefault();
        (window as any).trajNav(e.key==='ArrowRight'?1:-1);
      }
    });
    let _ts=0;
    const tsc=document.querySelector('.traj-scene')!;
    tsc.addEventListener('touchstart',e=>{ _ts=(e as TouchEvent).touches[0].clientX; },{ passive:true });
    tsc.addEventListener('touchend',e=>{
      const dx=(e as TouchEvent).changedTouches[0].clientX-_ts;
      if(Math.abs(dx)>40) (window as any).trajNav(dx<0?1:-1);
    });
  </script>

