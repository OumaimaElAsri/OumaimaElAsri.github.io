    function applyLang(){
      const l = (window as any)._lang as 'fr'|'en';
      document.documentElement.lang = l;
      document.querySelectorAll('[data-key]').forEach(el => {
        const k = el.getAttribute('data-key')!;
        if(TEXTS[k]) el.innerHTML = TEXTS[k][l];
      });
      document.querySelectorAll('.nav-r button').forEach(b => {
        const btn = b as HTMLButtonElement;
        if(btn.getAttribute('onclick')?.includes('toggleLang'))
          btn.textContent = l === 'fr' ? 'EN' : 'FR';
      });
      document.querySelectorAll('.mobile-menu button').forEach(b => {
        const btn = b as HTMLButtonElement;
        if(btn.textContent?.startsWith('Changer') || btn.textContent?.startsWith('Switch'))
          btn.textContent = l === 'fr' ? 'Switch language → EN' : 'Changer de langue → FR';
      });
      if(typeof (window as any).renderPanel === 'function') (window as any).renderPanel();
    }

    (window as any).toggleLang = function(){
      (window as any)._lang = (window as any)._lang === 'fr' ? 'en' : 'fr';
      applyLang();
    };

    applyLang();
