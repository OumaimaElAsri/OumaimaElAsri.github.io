---
// Projects component
---
<section id="projects" style="background:#0d0d0f;border-top:1px solid var(--border)">
  <div class="inner">
    <div class="sec-tag" data-key="p-tag">PROJETS</div>
    <h2 class="sh reveal" data-key="p-title">Travaux à venir.</h2>
    <p class="reveal" style="color:var(--sub);font-size:.9rem;margin-top:-1.25rem;margin-bottom:1.75rem" data-key="p-sub">Data Analyst · Data Engineer · Data Scientist · Full Stack · IA bout en bout.</p>
    <div class="proj-grid reveal">
      <div class="pcard">
        <div class="pcat" data-key="p1c">Data Engineering</div>
        <div class="ptitle" data-key="p1t">Pipeline bout en bout</div>
        <p class="pdesc" data-key="p1d">Pipeline data complet — ingestion, transformation, orchestration et exposition. À venir.</p>
        <div class="chips"><span class="chip">Spark</span><span class="chip">Airflow</span><span class="chip">BigQuery</span></div>
        <div class="parr">&#8599;</div>
      </div>
      <div class="pcard">
        <div class="pcat" data-key="p2c">Machine Learning</div>
        <div class="ptitle" data-key="p2t">Modèle ML en production</div>
        <p class="pdesc" data-key="p2d">Feature engineering, entraînement, évaluation et déploiement. À venir.</p>
        <div class="chips"><span class="chip">Python</span><span class="chip">Scikit-learn</span><span class="chip">MLflow</span></div>
        <div class="parr">&#8599;</div>
      </div>
      <div class="pcard">
        <div class="pcat" data-key="p3c">IA · Full Stack</div>
        <div class="ptitle" data-key="p3t">App data propulsée par l'IA</div>
        <p class="pdesc" data-key="p3d">Application full-stack intégrant LLMs et pipelines data pour des insights intelligents. À venir.</p>
        <div class="chips"><span class="chip">React</span><span class="chip">Python</span><span class="chip">LLM</span></div>
        <div class="parr">&#8599;</div>
      </div>
      <div class="padd">
        <span style="font-size:1rem;color:var(--muted)">+</span>
        <span data-key="p-add">Plus de projets à venir — Data Analyst · Data Scientist · Full Stack</span>
      </div>
    </div>
  </div>
</section>
