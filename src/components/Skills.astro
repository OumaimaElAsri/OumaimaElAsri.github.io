---
// Skills component
---
<section id="skills" style="background:#0d0d0f;border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="inner">
    <div class="sec-tag" data-key="sk-tag">COMPÉTENCES</div>
    <h2 class="sh" data-key="sk-title">Mon arsenal technique</h2>
    <div class="skills-grid">
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl1">Data Engineering &amp; Bases de données</div>
        <div class="chips"><span class="chip">Apache Spark</span><span class="chip">Airflow</span><span class="chip">BigQuery</span><span class="chip">SQL avancé</span><span class="chip">ETL</span><span class="chip">MySQL/Oracle</span><span class="chip">Azure Databricks</span></div>
      </div>
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl2">IA &amp; Machine Learning</div>
        <div class="chips"><span class="chip">Python</span><span class="chip">R</span><span class="chip">Pandas</span><span class="chip">NumPy</span><span class="chip">Scikit-learn</span><span class="chip">Random Forest</span><span class="chip">Jupyter</span></div>
      </div>
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl3">Visualisation &amp; BI</div>
        <div class="chips"><span class="chip">Power BI</span><span class="chip">Data Viz</span><span class="chip">Dashboards</span><span class="chip">Airflow</span></div>
      </div>
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl4">Full Stack &amp; DevOps</div>
        <div class="chips"><span class="chip">React</span><span class="chip">TypeScript</span><span class="chip">Java/Spring Boot</span><span class="chip">APIs REST</span><span class="chip">Docker</span><span class="chip">Kubernetes</span><span class="chip">Git/GitHub</span><span class="chip">GitLab</span></div>
      </div>
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl5">Gouvernance &amp; Qualité</div>
        <div class="chips"><span class="chip">RGPD</span><span class="chip">MDM</span><span class="chip">Data Quality</span><span class="chip">Documentation</span><span class="chip">Sécurité des données</span></div>
      </div>
      <div class="skill-block reveal">
        <div class="skill-block-title" data-key="skl6">Collaboration &amp; Outils</div>
        <div class="chips"><span class="chip">Agile</span><span class="chip">SharePoint</span><span class="chip">Teams</span><span class="chip">Trello</span><span class="chip">Microsoft Office</span></div>
      </div>
    </div>
  </div>
</section>
